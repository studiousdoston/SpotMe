{
  // Type-checks the unit tests (run by Node's built-in test runner, so they use Node types
  // instead of the browser app's). Part of `tsc -b` via tsconfig.json.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    // Bundler resolution (like the app) so extensionless '@/' type imports resolve;
    // Node itself only needs the explicit './overlayState.ts' import in the test.
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Same '@/' alias as the app (type-only imports in tested files) */
    "paths": {
      "@/*": ["./src/*"]
    },

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.test.ts"]
}
