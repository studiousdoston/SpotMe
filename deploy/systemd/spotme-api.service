# SpotMe API: FastAPI under uvicorn, reachable only from this machine (Nginx proxies /api to it).
# Install: see deploy/README.md.

[Unit]
Description=SpotMe API (FastAPI + uvicorn)
After=network.target

[Service]
Type=simple
User=doston
Group=doston
WorkingDirectory=/opt/doston/spotme/server
# Production mode: interactive API docs off (see server/main.py).
Environment=SPOTME_ENV=production
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/doston/spotme/server/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8020 --workers 2
Restart=always
RestartSec=3

# Shared VPS: keep SpotMe from starving the other app.
# MemoryHigh slows the service down (reclaims memory) before MemoryMax kills it.
MemoryHigh=400M
MemoryMax=512M

# Basic hardening: no privilege escalation, private /tmp, read-only system dirs, no access to /home.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
